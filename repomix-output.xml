<file path="app/src/main/java/com/duoc/aquaflow/domain/HistorialFiltro.kt">
package com.duoc.aquaflow.domain

import com.duoc.aquaflow.model.EstadoFaena
import com.duoc.aquaflow.model.HistorialItem

/** Filtros del historial: texto libre y estado. */
data class HistorialFiltro(
    val texto: String = "",
    val estado: EstadoFaena? = null
) {
    fun aplicar(items: List<HistorialItem>): List<HistorialItem> {
        val consulta = texto.trim().lowercase()
        return items.filter { item ->
            (estado == null || item.estado == estado) &&
                (consulta.isEmpty() || coincide(item, consulta))
        }
    }

    private fun coincide(item: HistorialItem, consulta: String): Boolean =
        item.codigo.lowercase().contains(consulta) ||
            item.centroCultivo.lowercase().contains(consulta) ||
            item.buzoAsignado.lowercase().contains(consulta) ||
            item.supervisorACargo.lowercase().contains(consulta)
}
</file>

<file path="app/src/main/java/com/duoc/aquaflow/domain/ReglasAst.kt">
package com.duoc.aquaflow.domain

import com.duoc.aquaflow.model.PREGUNTAS_AST
import com.duoc.aquaflow.model.PasoAst
import com.duoc.aquaflow.model.ResultadoAst

// Reglas del formulario AST (Kotlin puro, sin Android).
object ReglasAst {

    const val MAX_PASOS = 10

    // null = pregunta sin responder
    fun respuestasCompletas(respuestas: List<Boolean?>) =
        respuestas.size == PREGUNTAS_AST.size && respuestas.none { it == null }

    // Mensaje de error del formulario; null si está completo. La primera falla define el mensaje.
    fun error(tipologia: String, respuestas: List<Boolean?>, pasos: List<PasoAst>): String? = when {
        tipologia.isBlank() -> "Elige la tipología de la tarea"
        !respuestasCompletas(respuestas) -> "Responde todas las preguntas del chequeo inicial"
        pasos.isEmpty() || pasos.any { it.tarea.isBlank() || it.peligro.isBlank() } -> "Cada paso necesita tarea y peligro"
        pasos.any { it.control.isBlank() } -> "Cada peligro necesita su medida de control"
        else -> null
    }

    // Misma lógica de semáforo que el resto de la app: rojo > amarillo > verde
    fun resultado(respuestas: List<Boolean?>, pasos: List<PasoAst>, requiereNuevoAst: Boolean): ResultadoAst {
        // ¿Alguna pregunta crítica respondida "No"? (zip junta cada pregunta con su respuesta)
        val criticaFalla = PREGUNTAS_AST.zip(respuestas).any { (p, r) -> p.critica && r == false }
        val hayNo = respuestas.any { it == false }
        val hayRiesgoCritico = pasos.any { it.critico }
        return when {
            criticaFalla -> ResultadoAst.REQUIERE_REVISION
            hayNo || hayRiesgoCritico || requiereNuevoAst -> ResultadoAst.OBSERVADO
            else -> ResultadoAst.CUMPLE
        }
    }
}
</file>

<file path="app/src/main/java/com/duoc/aquaflow/domain/ReglasDecision.kt">
package com.duoc.aquaflow.domain

import com.duoc.aquaflow.model.Decision
import com.duoc.aquaflow.model.EstadoEquipo
import com.duoc.aquaflow.model.NivelSalud
import com.duoc.aquaflow.model.ResultadoAst
import com.duoc.aquaflow.model.ResultadoFaena
import com.duoc.aquaflow.model.ResumenFaena
import com.duoc.aquaflow.model.Rol

// Reglas de la toma de decisión (Kotlin puro, sin Android).
object ReglasDecision {

    // Partes de la faena que todavía no están completas
    fun faltantes(resumen: ResumenFaena): List<String> = buildList {
        val items = resumen.checklist?.items.orEmpty()
        if (items.isEmpty() || items.any { it.estado == EstadoEquipo.PENDIENTE }) add("Checklist")
        if (resumen.ast == null) add("AST")
        if (resumen.encuesta == null) add("Encuesta de salud")
    }

    // Semáforo global: gana el peor de checklist, AST y salud.
    // Es null mientras falte alguna parte, para no mostrar un verde engañoso.
    fun resultado(resumen: ResumenFaena): ResultadoFaena? {
        if (faltantes(resumen).isNotEmpty()) return null

        val checklist = resumen.checklist?.items.orEmpty().map {
            when (it.estado) {
                EstadoEquipo.NO_CUMPLE -> ResultadoFaena.REQUIERE_REVISION
                EstadoEquipo.OBSERVADO -> ResultadoFaena.OBSERVADO
                else -> ResultadoFaena.CUMPLE
            }
        }
        val ast = when (resumen.ast?.resultado) {
            ResultadoAst.REQUIERE_REVISION -> ResultadoFaena.REQUIERE_REVISION
            ResultadoAst.OBSERVADO -> ResultadoFaena.OBSERVADO
            else -> ResultadoFaena.CUMPLE
        }
        // El nivel de salud se recalcula con la misma regla usada al guardar la encuesta
        val salud = resumen.encuesta?.let { e ->
            when (Reglas.nivelSalud(e.sistolica, e.diastolica, e.saturacion, e.alertasEncuesta.size)) {
                NivelSalud.CRITICO -> ResultadoFaena.REQUIERE_REVISION
                NivelSalud.ATENCION -> ResultadoFaena.OBSERVADO
                NivelSalud.NORMAL -> ResultadoFaena.CUMPLE
            }
        } ?: ResultadoFaena.CUMPLE

        return (checklist + ast + salud).maxBy { it.ordinal }
    }

    // Según el README, la jefatura es quien autoriza o rechaza.
    // Es el único lugar donde se define quién puede decidir.
    fun puedeDecidir(rol: Rol) = rol == Rol.JEFE

    // Mensaje de error si la decisión no es válida; null si lo es.
    fun errorDecision(decision: Decision, resultado: ResultadoFaena, motivo: String): String? = when {
        decision == Decision.RECHAZADA && motivo.isBlank() ->
            "Indica el motivo del rechazo"
        decision == Decision.AUTORIZADA && resultado == ResultadoFaena.REQUIERE_REVISION && motivo.isBlank() ->
            "Para autorizar un resultado que requiere revisión, indica el motivo"
        else -> null
    }
}
