        Usuario("supervisor", "1234", Rol.SUPERVISOR),
        Usuario("jefe", "1234", Rol.JEFE)
    )

    private val _usuario = MutableStateFlow<Usuario?>(null)
    val usuario: StateFlow<Usuario?> = _usuario.asStateFlow()


