<file path="app/src/test/java/com/duoc/aquaflow/HistorialRoomViewModelTest.kt">
package com.duoc.aquaflow

import com.duoc.aquaflow.data.repository.ConsultaAperturas
import com.duoc.aquaflow.domain.HistorialFiltro
import com.duoc.aquaflow.model.*
import com.duoc.aquaflow.viewmodel.DetalleAperturaViewModel
import com.duoc.aquaflow.viewmodel.HistorialViewModel
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.ExperimentalCoroutinesApi
import kotlinx.coroutines.flow.*
import kotlinx.coroutines.launch
import kotlinx.coroutines.test.*
import org.junit.After
import org.junit.Before
import org.junit.Test
import org.junit.Assert.*

@OptIn(ExperimentalCoroutinesApi::class)
class HistorialRoomViewModelTest {
    private val dispatcher = StandardTestDispatcher()
    private val usuario = Usuario("jefe", "1234", Rol.JEFE)
    private val primera = PreChequeo("uuid-1", "Centro Norte", "22/10/2026", "09:00", "Ana", "Luis")
    private val segunda = primera.copy(id = "uuid-2", centroCultivo = "Centro Sur", buzoAsignado = "Pedro")
    private val consulta = ConsultaFake()

    @Before fun preparar() { Dispatchers.setMain(dispatcher) }
    @After fun terminar() { Dispatchers.resetMain() }

    @Test fun actualizaListaYConservaFiltroAlCambiarLosDatos() = runTest {
        val vm = HistorialViewModel(consulta, usuario)
        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.state.collect() }
        consulta.lista.value = listOf(primera, segunda)
        advanceUntilIdle()
        assertEquals(2, vm.state.value.total)
        vm.onTexto("  NORTE  ")
        advanceUntilIdle()
        assertEquals(listOf("uuid-1"), vm.state.value.faenas.map { it.id })
        consulta.lista.value = listOf(primera.copy(centroCultivo = "Centro Este"), segunda)
        advanceUntilIdle()
        assertTrue(vm.state.value.faenas.isEmpty())
        assertEquals(2, vm.state.value.total)
        vm.limpiar()
        advanceUntilIdle()
        assertEquals(2, vm.state.value.faenas.size)
    }

    @Test fun filtrosBuscanTodosLosCamposYCombinanEstado() {
        val item = primera.aHistorialItem()
        listOf("uuid-1", "norte", "ANA", "luis").forEach {
            assertEquals(listOf(item), HistorialFiltro(it, EstadoFaena.PRECHEQUEO).aplicar(listOf(item)))
        }
        assertTrue(HistorialFiltro("Ana", EstadoFaena.AUTORIZADA).aplicar(listOf(item)).isEmpty())
    }

    @Test fun historialVacioNoInventaDatosDemo() = runTest {
        val vm = HistorialViewModel(consulta, usuario)
        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.state.collect() }
        advanceUntilIdle()
        assertFalse(vm.state.value.cargando)
        assertEquals(0, vm.state.value.total)
        assertTrue(vm.state.value.faenas.isEmpty())
        assertNull(vm.state.value.error)
    }

    @Test fun falloDeLecturaPuedeReintentarse() = runTest {
        consulta.fallar = true
        val vm = HistorialViewModel(consulta, usuario)
        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.state.collect() }
        advanceUntilIdle()
        assertNotNull(vm.state.value.error)
        assertFalse(vm.state.value.cargando)
        consulta.fallar = false
        consulta.lista.value = listOf(primera)
        vm.reintentar()
        advanceUntilIdle()
        assertNull(vm.state.value.error)
        assertEquals(1, vm.state.value.total)
    }

    @Test fun detalleConsultaElIdCorrectoYReflejaActualizaciones() = runTest {
        consulta.lista.value = listOf(primera, segunda)
        val vm = DetalleAperturaViewModel(consulta, usuario, segunda.id)
        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.state.collect() }
        advanceUntilIdle()
        assertEquals(segunda, vm.state.value.apertura)
        val editada = segunda.copy(buzoAsignado = "Buzo corregido")
        consulta.lista.value = listOf(primera, editada)
        advanceUntilIdle()
        assertEquals(editada, vm.state.value.apertura)
        consulta.lista.value = listOf(primera)
        advanceUntilIdle()
        assertFalse(vm.state.value.cargando)
        assertNull(vm.state.value.apertura)
        assertNull(vm.state.value.error)
    }

    @Test fun detalleDistingueErrorDeRegistroAusenteYPermiteReintentar() = runTest {
        consulta.fallar = true
        val vm = DetalleAperturaViewModel(consulta, usuario, primera.id)
        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.state.collect() }
        advanceUntilIdle()
        assertNotNull(vm.state.value.error)
        consulta.fallar = false
        consulta.lista.value = listOf(primera)
        vm.reintentar()
        advanceUntilIdle()
        assertNull(vm.state.value.error)
        assertEquals(primera, vm.state.value.apertura)
    }

    private class ConsultaFake : ConsultaAperturas {
        val lista = MutableStateFlow<List<PreChequeo>>(emptyList())
        var fallar = false
        override fun observar(usuario: Usuario): Flow<List<PreChequeo>> = flow {
            check(!fallar)
            emitAll(lista)
        }
        override fun observarDetalle(id: String, usuario: Usuario) =
            observar(usuario).map { lista -> lista.find { it.id == id } }
    }
}
</file>

<file path="app/src/test/java/com/duoc/aquaflow/ReglasAstTest.kt">
package com.duoc.aquaflow

import com.duoc.aquaflow.domain.ReglasAst
import com.duoc.aquaflow.model.PREGUNTAS_AST
import com.duoc.aquaflow.model.PasoAst
import com.duoc.aquaflow.model.ResultadoAst
import com.duoc.aquaflow.model.TIPOLOGIAS_AST
import com.duoc.aquaflow.viewmodel.AstViewModel
import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertNull
import org.junit.Assert.assertTrue
import org.junit.Test

private val TODO_SI: List<Boolean?> = List(PREGUNTAS_AST.size) { true }
private val PASO_OK = PasoAst("Revisar red", "Corriente fuerte", "Cabo de seguridad")
private fun conNo(i: Int): List<Boolean?> = TODO_SI.toMutableList().also { it[i] = false }

class ReglasAstTest {

    @Test fun formularioCompleto_noTieneError() =
        assertNull(ReglasAst.error(TIPOLOGIAS_AST[0], TODO_SI, listOf(PASO_OK)))

    @Test fun sinTipologia_esError() =
        assertEquals("Elige la tipología de la tarea", ReglasAst.error(" ", TODO_SI, listOf(PASO_OK)))

    @Test fun respuestasIncompletas_esError() {
        val incompletas: List<Boolean?> = TODO_SI.toMutableList().also { it[2] = null }
        assertFalse(ReglasAst.respuestasCompletas(incompletas))
        assertEquals("Responde todas las preguntas del chequeo inicial",
            ReglasAst.error(TIPOLOGIAS_AST[0], incompletas, listOf(PASO_OK)))
    }

    @Test fun pasoSinPeligro_esError() =
        assertEquals("Cada paso necesita tarea y peligro",
            ReglasAst.error(TIPOLOGIAS_AST[0], TODO_SI, listOf(PASO_OK.copy(peligro = ""))))

    @Test fun peligroSinControl_esError() =
        assertEquals("Cada peligro necesita su medida de control",
            ReglasAst.error(TIPOLOGIAS_AST[0], TODO_SI, listOf(PASO_OK.copy(control = ""))))

    @Test fun todoSi_esCumple() =
        assertEquals(ResultadoAst.CUMPLE, ReglasAst.resultado(TODO_SI, listOf(PASO_OK), false))

    @Test fun preguntaCriticaNo_requiereRevision() =
        assertEquals(ResultadoAst.REQUIERE_REVISION, ReglasAst.resultado(conNo(0), listOf(PASO_OK), false))

    @Test fun preguntaNoCriticaNo_esObservado() =
        assertEquals(ResultadoAst.OBSERVADO, ReglasAst.resultado(conNo(3), listOf(PASO_OK), false))

    @Test fun riesgoCritico_esObservado() =
        assertEquals(ResultadoAst.OBSERVADO, ReglasAst.resultado(TODO_SI, listOf(PASO_OK.copy(critico = true)), false))

    @Test fun requiereNuevoAst_esObservado() =
        assertEquals(ResultadoAst.OBSERVADO, ReglasAst.resultado(TODO_SI, listOf(PASO_OK), true))
}

class AstViewModelTest {

    private fun vmCompleto() = AstViewModel().apply {
        elegirTipologia(TIPOLOGIAS_AST[0])
        PREGUNTAS_AST.indices.forEach { responder(it, true) }
        cambiarPaso(0, PASO_OK)
    }

    @Test fun vacio_noGuardaYPideCompletar() {
        val vm = AstViewModel()
        assertNull(vm.guardar())
        assertEquals("Elige la tipología de la tarea", vm.ui.value.error)
    }

    @Test fun completo_guardaConResultadoCumple() {
        val f = vmCompleto().guardar()!!
        assertEquals(TIPOLOGIAS_AST[0], f.tipologia)
        assertEquals(ResultadoAst.CUMPLE, f.resultado)
    }

    @Test fun cargar_restauraLoGuardado() {
        val guardado = vmCompleto().apply { alternarNuevoAst() }.guardar()!!
        val otro = AstViewModel().apply { cargar(guardado) }
        assertEquals(guardado, otro.guardar())
    }

    @Test fun semaforoEnVivo_apareceAlResponderTodo() {
        val vm = AstViewModel()
        assertNull(vm.ui.value.resultado)
        PREGUNTAS_AST.indices.forEach { vm.responder(it, true) }
        assertEquals(ResultadoAst.CUMPLE, vm.ui.value.resultado)
    }

    @Test fun nuncaQuedaSinPasos() {
        val vm = AstViewModel()
        vm.quitarPaso(0)
        assertEquals(1, vm.ui.value.pasos.size)
    }

    @Test fun respetaElMaximoDePasos() {
        val vm = AstViewModel()
        repeat(ReglasAst.MAX_PASOS + 5) { vm.agregarPaso() }
        assertEquals(ReglasAst.MAX_PASOS, vm.ui.value.pasos.size)
    }

    @Test fun responderFueraDeIndice_seIgnora() {
        val vm = AstViewModel()
        vm.responder(99, true)
        assertTrue(vm.ui.value.respuestas.all { it == null })
    }
}
</file>

<file path="app/src/test/java/com/duoc/aquaflow/ReglasDecisionTest.kt">
package com.duoc.aquaflow

import com.duoc.aquaflow.domain.ReglasDecision
import com.duoc.aquaflow.model.ChecklistFaena
import com.duoc.aquaflow.model.Decision
import com.duoc.aquaflow.model.EncuestaSalud
import com.duoc.aquaflow.model.EstadoEquipo
import com.duoc.aquaflow.model.FormularioAst
import com.duoc.aquaflow.model.ItemEquipamiento
import com.duoc.aquaflow.model.NivelSalud
import com.duoc.aquaflow.model.PREGUNTAS_AST
import com.duoc.aquaflow.model.PasoAst
import com.duoc.aquaflow.model.PreChequeo
import com.duoc.aquaflow.model.ResultadoAst
import com.duoc.aquaflow.model.ResultadoFaena
import com.duoc.aquaflow.model.ResumenFaena
import com.duoc.aquaflow.model.Rol
import com.duoc.aquaflow.viewmodel.ResumenFaenaViewModel
import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertNull
import org.junit.Assert.assertTrue
import org.junit.Test

private fun cl(vararg estados: EstadoEquipo) =
    ChecklistFaena("f1", estados.mapIndexed { i, e -> ItemEquipamiento("$i", "Equipo $i", "desc", e) })

private fun astDe(r: ResultadoAst = ResultadoAst.CUMPLE) = FormularioAst(
    "Inspección de redes", false, List(PREGUNTAS_AST.size) { true }, listOf(PasoAst("t", "p", "c")), r
)

private fun salud(sat: Int = 98, alertas: List<String> = emptyList()) =
    EncuestaSalud(120, 80, sat, alertas, NivelSalud.NORMAL)

private fun resumen(
    checklist: ChecklistFaena? = cl(EstadoEquipo.CUMPLE, EstadoEquipo.CUMPLE),
    ast: FormularioAst? = astDe(),
    encuesta: EncuestaSalud? = salud()
) = ResumenFaena(PreChequeo(centroCultivo = "Centro Norte"), checklist, ast, encuesta)

class ReglasDecisionTest {

    @Test fun todoCumple_esCumple() =
        assertEquals(ResultadoFaena.CUMPLE, ReglasDecision.resultado(resumen()))

    @Test fun sinChecklist_noHayResultadoYFaltaChecklist() {
        val r = resumen(checklist = null)
        assertNull(ReglasDecision.resultado(r))
        assertEquals(listOf("Checklist"), ReglasDecision.faltantes(r))
    }

    @Test fun checklistConPendientes_cuentaComoFaltante() =
        assertTrue("Checklist" in ReglasDecision.faltantes(resumen(checklist = cl(EstadoEquipo.CUMPLE, EstadoEquipo.PENDIENTE))))

    @Test fun faltanVariasPartes_lasListaTodas() =
        assertEquals(listOf("Checklist", "AST", "Encuesta de salud"),
            ReglasDecision.faltantes(resumen(checklist = null, ast = null, encuesta = null)))

    @Test fun equipoNoCumple_requiereRevision() =
        assertEquals(ResultadoFaena.REQUIERE_REVISION,
            ReglasDecision.resultado(resumen(checklist = cl(EstadoEquipo.CUMPLE, EstadoEquipo.NO_CUMPLE))))

    @Test fun equipoObservado_esObservado() =
        assertEquals(ResultadoFaena.OBSERVADO,
            ReglasDecision.resultado(resumen(checklist = cl(EstadoEquipo.OBSERVADO))))

    @Test fun astObservado_esObservado() =
        assertEquals(ResultadoFaena.OBSERVADO, ReglasDecision.resultado(resumen(ast = astDe(ResultadoAst.OBSERVADO))))

    @Test fun astRojo_requiereRevision() =
        assertEquals(ResultadoFaena.REQUIERE_REVISION,
            ReglasDecision.resultado(resumen(ast = astDe(ResultadoAst.REQUIERE_REVISION))))

    @Test fun saludCritica_requiereRevision() =
        assertEquals(ResultadoFaena.REQUIERE_REVISION, ReglasDecision.resultado(resumen(encuesta = salud(sat = 90))))

    @Test fun saludConAlerta_esObservado() =
        assertEquals(ResultadoFaena.OBSERVADO, ReglasDecision.resultado(resumen(encuesta = salud(alertas = listOf("a")))))

    @Test fun ganaElPeor() =
        assertEquals(ResultadoFaena.REQUIERE_REVISION,
            ReglasDecision.resultado(resumen(checklist = cl(EstadoEquipo.OBSERVADO), encuesta = salud(sat = 90))))

    @Test fun soloLaJefaturaDecide() {
        assertTrue(ReglasDecision.puedeDecidir(Rol.JEFE))
        assertFalse(ReglasDecision.puedeDecidir(Rol.SUPERVISOR))
    }

    @Test fun rechazoSinMotivo_esError() =
        assertNotNull(ReglasDecision.errorDecision(Decision.RECHAZADA, ResultadoFaena.CUMPLE, "  "))

    @Test fun autorizarVerdeSinMotivo_esValido() =
        assertNull(ReglasDecision.errorDecision(Decision.AUTORIZADA, ResultadoFaena.CUMPLE, ""))

    @Test fun autorizarRojoSinMotivo_esError() =
        assertNotNull(ReglasDecision.errorDecision(Decision.AUTORIZADA, ResultadoFaena.REQUIERE_REVISION, ""))

    @Test fun autorizarRojoConMotivo_esValido() =
        assertNull(ReglasDecision.errorDecision(Decision.AUTORIZADA, ResultadoFaena.REQUIERE_REVISION, "Equipo repuesto"))
}

class ResumenFaenaViewModelTest {

    @Test fun supervisor_noPuedeDecidir() {
        val vm = ResumenFaenaViewModel()
        assertNull(vm.decidir(Decision.AUTORIZADA, resumen(), Rol.SUPERVISOR, "Ana"))
        assertEquals("Solo la jefatura puede autorizar o rechazar", vm.ui.value.error)
    }

    @Test fun resumenIncompleto_noDecide() {
        val vm = ResumenFaenaViewModel()
        assertNull(vm.decidir(Decision.AUTORIZADA, resumen(checklist = null), Rol.JEFE, "Luis"))
        assertEquals("Faltan datos para decidir: Checklist", vm.ui.value.error)
    }

    @Test fun jefeAutorizaFaenaVerde_devuelveRegistro() {
        val registro = ResumenFaenaViewModel().decidir(Decision.AUTORIZADA, resumen(), Rol.JEFE, "Luis")!!
        assertEquals(Decision.AUTORIZADA, registro.decision)
        assertEquals("Luis", registro.decididoPor)
    }

