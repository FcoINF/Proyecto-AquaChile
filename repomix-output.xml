<file path="app/src/main/java/com/duoc/aquaflow/viewmodel/EncuestaSaludViewModel.kt">
package com.duoc.aquaflow.viewmodel

import androidx.lifecycle.ViewModel
import com.duoc.aquaflow.domain.Reglas
import com.duoc.aquaflow.model.EncuestaSalud
import com.duoc.aquaflow.model.NivelSalud
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update

// Todo lo que muestra la encuesta en un solo objeto inmutable.
data class EncuestaSaludUiState(
    val sistolica: String = "",
    val diastolica: String = "",
    val saturacion: String = "",
    val alertas: Set<String> = emptySet(),   // preguntas respondidas "Sí"
    val error: String? = null
) {
    // Nivel de salud en vivo (null mientras falten números)
    val salud: NivelSalud?
        get() {
            val sis = sistolica.toIntOrNull() ?: return null
            val dia = diastolica.toIntOrNull() ?: return null
            val sat = saturacion.toIntOrNull() ?: return null
            return Reglas.nivelSalud(sis, dia, sat, alertas.size)
        }

    // Marcan el campo en rojo apenas el valor digitado queda fuera de rango
    val sistolicaFuera get() = fuera(sistolica, Reglas.RANGO_SISTOLICA)
    val diastolicaFuera get() = fuera(diastolica, Reglas.RANGO_DIASTOLICA)
    val saturacionFuera get() = fuera(saturacion, Reglas.RANGO_SATURACION)

    private fun fuera(texto: String, rango: IntRange) = texto.toIntOrNull()?.let { it !in rango } == true
}

// Maneja la encuesta: guarda el estado, valida y entrega la encuesta lista para el pre-chequeo.
class EncuestaSaludViewModel : ViewModel() {
    // `_ui` (privado, mutable) solo lo cambia el ViewModel; `ui` (público) lo observa la pantalla.
    private val _ui = MutableStateFlow(EncuestaSaludUiState())
    val ui: StateFlow<EncuestaSaludUiState> = _ui.asStateFlow()

    private var encuestaCargada = false

    // Carga una sola vez para no sobrescribir ediciones al rotar la pantalla.
    fun cargar(encuesta: EncuestaSalud) {
        if (encuestaCargada) return
        encuestaCargada = true
        _ui.value = EncuestaSaludUiState(
            sistolica = encuesta.sistolica.toString(),
            diastolica = encuesta.diastolica.toString(),
            saturacion = encuesta.saturacion.toString(),
            alertas = encuesta.alertasEncuesta.toSet()
        )
    }

    fun cambiarSistolica(v: String) = _ui.update { it.copy(sistolica = v.soloNumeros(), error = null) }
    fun cambiarDiastolica(v: String) = _ui.update { it.copy(diastolica = v.soloNumeros(), error = null) }
    fun cambiarSaturacion(v: String) = _ui.update { it.copy(saturacion = v.soloNumeros(), error = null) }

    // Un "Sí" entra al conjunto de alertas; al desmarcarlo sale
    fun alternarAlerta(pregunta: String) = _ui.update {
        it.copy(alertas = if (pregunta in it.alertas) it.alertas - pregunta else it.alertas + pregunta, error = null)
    }

    // Devuelve la encuesta si todo es válido; si no, deja el mensaje en `ui.error` y devuelve null.
    fun guardar(): EncuestaSalud? {
        val s = _ui.value
        val sis = s.sistolica.toIntOrNull()
        val dia = s.diastolica.toIntOrNull()
        val sat = s.saturacion.toIntOrNull()

        // La primera validación que falle define el mensaje que ve el usuario
        val error = when {
            sis == null || dia == null || sat == null -> "Completa presión y saturación"
            !Reglas.enRango(sis, dia, sat) -> "Valores de salud fuera de rango"
            else -> null
        }
        if (error != null || sis == null || dia == null || sat == null) {
            _ui.update { it.copy(error = error) }
            return null
        }
        return EncuestaSalud(sis, dia, sat, s.alertas.toList(), Reglas.nivelSalud(sis, dia, sat, s.alertas.size))
    }
}

private fun String.soloNumeros() = filter { it.isDigit() }.take(3)
</file>

<file path="app/src/main/java/com/duoc/aquaflow/viewmodel/HistorialViewModel.kt">
package com.duoc.aquaflow.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.duoc.aquaflow.data.repository.ConsultaAperturas
import com.duoc.aquaflow.domain.HistorialFiltro
import com.duoc.aquaflow.model.EstadoFaena
import com.duoc.aquaflow.model.HistorialItem
import com.duoc.aquaflow.model.Usuario
import com.duoc.aquaflow.model.aHistorialItem
import kotlinx.coroutines.ExperimentalCoroutinesApi
import kotlinx.coroutines.flow.*

data class HistorialUiState(
    val cargando: Boolean = true,
    val error: String? = null,
    val total: Int = 0,
    val filtro: HistorialFiltro = HistorialFiltro(),
    val faenas: List<HistorialItem> = emptyList()
)

@OptIn(ExperimentalCoroutinesApi::class)
class HistorialViewModel(consulta: ConsultaAperturas, usuario: Usuario) : ViewModel() {
    private val filtro = MutableStateFlow(HistorialFiltro())
    private val intentos = MutableStateFlow(0)

    // Room emite de nuevo cuando cambia una apertura guardada.
    private val datos = intentos.flatMapLatest {
        consulta.observar(usuario).map { lista ->
            val items = lista.map { it.aHistorialItem() }
            HistorialUiState(cargando = false, total = items.size, faenas = items)
        }.onStart { emit(HistorialUiState()) }
            .catch { emit(HistorialUiState(cargando = false, error = "No se pudo cargar el historial.")) }
    }

    val state = combine(datos, filtro) { datos, filtro ->
        datos.copy(filtro = filtro, faenas = filtro.aplicar(datos.faenas))
    }.stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), HistorialUiState())

    fun onTexto(texto: String) = filtro.update { it.copy(texto = texto.take(60)) }
    fun onEstado(estado: EstadoFaena?) = filtro.update { it.copy(estado = estado) }
    fun limpiar() { filtro.value = HistorialFiltro() }
    fun reintentar() { intentos.update { it + 1 } }
}
</file>

<file path="app/src/test/java/com/duoc/aquaflow/BorradorAperturaTest.kt">
package com.duoc.aquaflow

import com.duoc.aquaflow.model.Rol
import com.duoc.aquaflow.model.Usuario
import com.duoc.aquaflow.viewmodel.FaenaViewModel
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.ExperimentalCoroutinesApi
import kotlinx.coroutines.test.StandardTestDispatcher
import kotlinx.coroutines.test.resetMain
import kotlinx.coroutines.test.runTest
import kotlinx.coroutines.test.setMain
import kotlinx.coroutines.test.advanceUntilIdle
import org.junit.After
import org.junit.Before
import org.junit.Test
import org.junit.Assert.*

@OptIn(ExperimentalCoroutinesApi::class)
class BorradorAperturaTest {
    private val dispatcher = StandardTestDispatcher()
    private val datos = BorradoresMemoria()
    private val usuario = Usuario("supervisor", "1234", Rol.SUPERVISOR)
    @Before fun preparar() { Dispatchers.setMain(dispatcher) }
    @After fun terminar() { Dispatchers.resetMain() }

    @Test fun recuperaBorradorIncompletoEnOtroViewModelSinCambiarIdentidad() = runTest {
        val original = FaenaViewModel(datos).apply { iniciar(usuario) }
        original.actualizar(original.ui.value.apertura.copy(centroCultivo = "Centro demo"))
        original.guardarApertura()
        advanceUntilIdle()
        val nuevo = FaenaViewModel(datos).apply { iniciar(usuario) }
        nuevo.recuperarApertura()
        advanceUntilIdle()
        assertEquals(original.ui.value.apertura, nuevo.ui.value.apertura)
        assertFalse(nuevo.confirmarApertura())
        assertNotNull(nuevo.ui.value.error)
    }

    @Test fun falloAlGuardarNoNavegaYPermiteReintentar() = runTest {
        val vm = FaenaViewModel(datos).apply { iniciar(usuario) }
        vm.actualizar(vm.ui.value.apertura.copy(
            centroCultivo = "Centro",
            buzoAsignado = "Buzo",
            condicionesListas = true,
            embarcacionLista = true,
            comunicacionesOperativas = true
        ))
        var avances = 0
        datos.fallar = true
        vm.guardarApertura(continuar = true) { avances++ }
        advanceUntilIdle()
        assertEquals(0, avances)
        assertNotNull(vm.ui.value.error)
        assertFalse(vm.ui.value.ocupado)
        datos.fallar = false
        vm.guardarApertura(continuar = true) { avances++ }
        advanceUntilIdle()
        assertEquals(1, avances)
        assertNotNull(datos.apertura)
    }

    @Test fun noRecuperaAperturaDeOtroSupervisor() = runTest {
        val vm = FaenaViewModel(datos).apply { iniciar(usuario) }
        vm.guardarApertura()
        advanceUntilIdle()
        val otro = FaenaViewModel(datos).apply { iniciar(usuario.copy(nombre = "otro")) }
        val inicial = otro.ui.value.apertura
        otro.recuperarApertura()
        advanceUntilIdle()
        assertEquals(inicial, otro.ui.value.apertura)
        assertEquals("No tienes aperturas guardadas.", otro.ui.value.mensaje)
    }
}
